// =====================================================================
// RUTINA 2.0 — Skema database (SQLite / Turso libsql)
// ---------------------------------------------------------------------
// Konvensi selaras dengan lapisan Zustand (src/components/rutina-mobile/
// store.ts):
//  - ID domain dibuat aplikasi (uuid) → String @id tanpa default.
//  - Tanggal domain memakai string ISO "yyyy-mm-dd" (aman zona waktu
//    lokal, identik util isoOf/todayISO di store).
//  - Daftar (schedule hari, set latihan) disimpan sebagai JSON string —
//    tipe primitif daftar tidak didukung SQLite.
//  - Nominal uang disimpan Integer (Rupiah, tanpa sen).
//
// Deployment Vercel + Turso: klien memakai driver adapter
// (@prisma/adapter-libsql) — lihat src/lib/db.ts. Sinkronisasi skema ke
// Turso: `bun run db:push-turso` (membuat DDL via prisma migrate diff
// lalu mengeksekusinya lewat @libsql/client).
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ===== Domain Kebiasaan ===== */

model Habit {
  id          String     @id
  title       String
  desc        String
  cat         String // HabitCat: Kebiasaan|Kerja|Kesehatan|Pribadi|Belajar
  schedule    String // JSON: number[] — hari aktif 0=Minggu..6=Sabtu
  weeklyTarget Int      @default(7)
  reminder    String? // "HH:MM"
  restDays    String     @default("[]") // JSON: string[] — ISO jeda runtun terjadwal
  afterId     String? // Susun Kebiasaan — id kebiasaan pemicu
  mini        String     @default("") // Versi 2 Menit
  archived    Boolean    @default(false)
  createdAt   String // ISO yyyy-mm-dd — batas hitung streak
  logs        HabitLog[]

  @@map("rutina_habits")
}

/// completions[tanggalISO][habitId] = true — satu baris per centang.
model HabitLog {
  id      String @id @default(cuid())
  habitId String
  date    String // ISO yyyy-mm-dd
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])

  @@map("rutina_habit_logs")
}

/* ===== Domain Jurnal ===== */

model JournalNote {
  id      String  @id
  title   String
  body    String
  date    String // ISO yyyy-mm-dd
  pinned  Boolean @default(false)
  tone    Int     @default(0)
  folder  String // FolderKey: kerja|ide|bacaan|pribadi

  @@index([folder])
  @@index([date])

  @@map("rutina_journal_notes")
}

/* ===== Domain Keuangan ===== */

model Wallet {
  id      String @id
  name    String
  initial Int    @default(0) // saldo awal (Rp)

  @@map("rutina_wallets")
}

model Transaction {
  id         String  @id
  type       String // TxType: masuk|keluar|transfer
  cat        String // FinCat
  amount     Int // Rp
  note       String  @default("")
  ts         String // ISO yyyy-mm-dd
  walletId   String? // dompet sumber (keluar/transfer) / tujuan (masuk)
  toWalletId String? // dompet tujuan — khusus transfer
  recurrence String? // mingguan|bulanan — templat berulang
  recurOf    String? // ID templat asal — salinan otomatis

  @@index([ts])
  @@index([type])
  @@index([walletId])

  @@map("rutina_transactions")
}

/// Kategori keuangan buatan pengguna — satu sistem kategori terpadu
/// bersama kategori bawaan + impor Rutina 1.0 (v2.17). v2.18: FLAT —
/// tanpa subkategori (permintaan pengguna: kategori saja cukup).
model FinCategory {
  id       String  @id // fcat-<ts>
  name     String // nama tampilan (unik per arus)
  type     String // 'keluar' | 'masuk'
  archived Boolean @default(false)

  @@index([type])

  @@map("rutina_fin_categories")
}

/// Anggaran bulanan per kategori pengeluaran (Rp).
model Budget {
  cat    String @id // FinCat kunci pengeluaran
  amount Int

  @@map("rutina_budgets")
}

/// Target tabungan.
model Goal {
  id     String @id
  name   String
  target Int
  saved  Int    @default(0)

  @@map("rutina_goals")
}

/* ===== Domain Bugar — Latihan ===== */

/// kind: beban | jalan | lari | lari-jalan | badminton (v2.17:
/// empat jenis aktivitas — pusat catatan, bukan pelacak GPS).
model WorkoutSession {
  id       String  @id
  kind     String // WorkoutKind
  date     String // ISO yyyy-mm-dd
  duration Int // menit
  note     String  @default("")
  sets     String  @default("[]") // JSON: WorkoutSet[] — khusus 'beban'
  distance Float? // km — khusus kardio (jalan/lari/lari-jalan)
  kcal     Int? // kalori dari smartwatch (opsional — v2.17)

  @@index([date])

  @@map("rutina_workout_sessions")
}

/* ===== Domain Bugar — Asupan ===== */

model FoodEntry {
  id       String  @id
  date     String // ISO yyyy-mm-dd
  name     String
  cat      String // kategori master makanan
  unit     String // satuan porsi master
  portion  Float   @default(1)
  meal     String // MealSlot: sarapan|makan siang|makan malam|camilan
  kcal     Int
  protein  Float?
  carb     Float?
  fat      Float?

  @@index([date])

  @@map("rutina_food_entries")
}

/* ===== Domain Bugar — Tubuh ===== */

/// Satu catatan tubuh per tanggal (UPSERT harian).
model BodyLog {
  date     String  @id // ISO yyyy-mm-dd
  water    Int     @default(0) // gelas
  weight   Float? // kg
  sleepH   Float? // jam tidur semalam
  energy   Int? // 1–5
  soreness Int? // DOMS / nyeri otot 1–5
  stress   Int? // tingkat stres 1–5

  @@map("rutina_body_logs")
}

/// Riwayat mood per tanggal (Rutina lama: DailyLog).
model MoodLog {
  date String @id // ISO yyyy-mm-dd
  mood String // nama mood, mis. "Ceria"

  @@map("rutina_mood_logs")
}

/* ===== Pengaturan aplikasi (k-v) ===== */

/// Preferensi pengguna: mood harian, dailyGoal, calorieTarget, dsb.
model AppSetting {
  key   String @id
  value String // nilai terserialisasi (string/angka/JSON)

  @@map("rutina_app_settings")
}
