# =====================================================================
# RUTINA 2.0 — contoh variabel lingkungan
# Salin menjadi .env lalu sesuaikan nilainya. JANGAN commit .env.
# =====================================================================

# --- Database (Prisma + libsql) ---------------------------------------
# Lokal / sandbox: SQLite file
DATABASE_URL="file:./db/custom.db"

# Produksi (Vercel + Turso) — set di dashboard Vercel, bukan di sini:
#   DATABASE_URL        = libsql://<nama-database>-<org>.turso.io
#   DATABASE_AUTH_TOKEN = <token akses database Turso>
#
# Bila TURSO_* di bawah diisi, kredensial itu MENANG atas DATABASE_*
# (lihat src/lib/db.ts) — berguna di sandbox yang shell-nya masih
# mengekspor DATABASE_URL=file: lama.

# --- Turso (opsional; kredensial utama + untuk `bun run db:push-turso`) ---
# TURSO_DATABASE_URL="libsql://<nama-database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token akses database Turso>"
